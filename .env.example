# Copy these values into your shell or deployment secret settings.
# Keep AI_ENABLED=false until you have configured a provider and reviewed consent.
AI_ENABLED=false
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=35

# Optional local provider settings when AI_PROVIDER=ollama
LOCAL_AI_OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
